---
import Base from '../layouts/Base.astro';
import { guide } from '../data/guide';

const locales = ['en', 'vi'] as const;
---

<Base title="User guide" description={guide.en.pageDescription}>
  <div id="guide-top" class="guide wrap">
    <header class="guide__hero">
      <div class="guide__language" role="group" aria-label="Guide language">
        {locales.map((locale) => (
          <button
            type="button"
            class="guide__language-button"
            data-guide-language={locale}
            aria-pressed={locale === 'en' ? 'true' : 'false'}
          >
            {guide[locale].languageName}
          </button>
        ))}
      </div>

      {locales.map((locale) => (
        <div
          class="guide__hero-copy"
          data-guide-panel={locale}
          data-page-title={guide[locale].pageTitle}
          data-page-description={guide[locale].pageDescription}
          lang={locale}
          hidden={locale === 'vi'}
        >
          <p class="eyebrow">{guide[locale].kicker}</p>
          <h1>{guide[locale].pageTitle}</h1>
          <p>{guide[locale].intro}</p>
        </div>
      ))}
    </header>

    {locales.map((locale) => {
      const copy = guide[locale];
      return (
        <article class="guide__body" data-guide-panel={locale} lang={locale} hidden={locale === 'vi'}>
          <nav class="guide__contents card" aria-labelledby={`guide-contents-${locale}`}>
            <div>
              <p class="eyebrow">12 {locale === 'en' ? 'TOPICS' : 'CHỦ ĐỀ'}</p>
              <h2 id={`guide-contents-${locale}`}>{copy.contentsTitle}</h2>
              <p>{copy.contentsHint}</p>
            </div>
            <ol>
              {copy.sections.map((section) => (
                <li><a href={`#${section.id}-${locale}`}>{section.title}</a></li>
              ))}
            </ol>
          </nav>

          <div class="guide__sections">
            {copy.sections.map((section) => (
              <section id={`${section.id}-${locale}`} class="guide__section">
                <div class="guide__section-heading">
                  <div>
                    {section.badge && <span class="guide__badge">{section.badge}</span>}
                    <h2>{section.title}</h2>
                    <p>{section.intro}</p>
                  </div>
                  <a class="guide__top-link" href="#guide-top">↑ {copy.backToTop}</a>
                </div>

                <ol class="guide__steps" aria-label={section.title}>
                  {section.steps.map((step, index) => (
                    <li>
                      <span class="guide__step-number" aria-hidden="true">{index + 1}</span>
                      <div>
                        <span class="sr-only">{copy.stepLabel} {index + 1}: </span>
                        {step}
                      </div>
                    </li>
                  ))}
                </ol>

                {section.id === 'widgets' && (
                  <figure class="guide__widget-demo">
                    <div class="guide__phone">
                      <img
                        src="/guide/home-widget.gif"
                        width="320"
                        height="693"
                        loading="lazy"
                        decoding="async"
                        alt={copy.widgetCaption}
                      />
                    </div>
                    <figcaption>{copy.widgetCaption}</figcaption>
                  </figure>
                )}

                {section.notes && (
                  <aside class="guide__notes">
                    <strong>{copy.noteLabel}</strong>
                    <ul>
                      {section.notes.map((note) => <li>{note}</li>)}
                    </ul>
                  </aside>
                )}
              </section>
            ))}
          </div>
        </article>
      );
    })}
  </div>

  <script is:inline>
    (() => {
      const storageKey = 'loggoo-guide-language';
      const buttons = Array.from(document.querySelectorAll('[data-guide-language]'));
      const panels = Array.from(document.querySelectorAll('[data-guide-panel]'));

      const showLanguage = (language, remember = true) => {
        const next = language === 'vi' ? 'vi' : 'en';
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.guidePanel !== next;
        });
        buttons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.guideLanguage === next));
        });
        document.documentElement.lang = next;

        const activeHero = document.querySelector(`.guide__hero-copy[data-guide-panel="${next}"]`);
        if (activeHero) {
          document.title = `${activeHero.dataset.pageTitle} · loggoo`;
          const description = document.querySelector('meta[name="description"]');
          if (description) description.setAttribute('content', activeHero.dataset.pageDescription || '');
        }

        if (remember) {
          try { localStorage.setItem(storageKey, next); } catch (_) {}
        }
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => showLanguage(button.dataset.guideLanguage));
      });

      let savedLanguage = 'en';
      try { savedLanguage = localStorage.getItem(storageKey) || 'en'; } catch (_) {}
      showLanguage(savedLanguage, false);
    })();
  </script>
</Base>

<style>
  .guide { max-width: 1040px; padding-top: 68px; }

  .guide__hero {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 6vw, 64px);
    border: 1px solid var(--lg-primary-container-line);
    border-radius: var(--lg-radius-panel);
    background:
      radial-gradient(circle at 90% 8%, color-mix(in srgb, var(--lg-mood-radiant) 72%, transparent) 0 12%, transparent 33%),
      linear-gradient(145deg, var(--lg-surface) 0%, var(--lg-primary-container) 100%);
  }

  .guide__language {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    margin-bottom: 46px;
    border: 1px solid var(--lg-outline);
    border-radius: 16px;
    background: color-mix(in srgb, var(--lg-surface) 82%, transparent);
  }

  .guide__language-button {
    min-height: 40px;
    padding: 8px 14px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--lg-on-surface-variant);
    font: 700 14px var(--lg-font-display);
    cursor: pointer;
  }

  .guide__language-button[aria-pressed='true'] {
    background: var(--lg-primary);
    color: var(--lg-on-primary);
    box-shadow: 0 5px 16px -11px rgba(74, 55, 40, .8);
  }

  .guide__hero-copy { max-width: 720px; }
  .guide__hero-copy h1 { margin-top: 10px; font-size: clamp(38px, 6.4vw, 68px); line-height: 1.02; letter-spacing: -2.4px; }
  .guide__hero-copy > p:last-child { max-width: 680px; margin: 22px 0 0; color: var(--lg-on-surface-variant); font-size: clamp(17px, 2vw, 20px); line-height: 1.65; }

  .guide__body { padding-top: 34px; }

  .guide__contents { display: grid; grid-template-columns: minmax(220px, .72fr) 1.4fr; gap: 40px; padding: clamp(24px, 4vw, 38px); }
  .guide__contents h2 { margin-top: 8px; font-size: 28px; }
  .guide__contents div > p:last-child { margin: 10px 0 0; color: var(--lg-on-surface-variant); }
  .guide__contents ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 26px; margin: 0; padding-left: 22px; }
  .guide__contents li { color: var(--lg-on-surface-subtle); }
  .guide__contents a { display: inline-block; padding: 3px 0; color: var(--lg-on-surface-variant); font-weight: 700; }
  .guide__contents a:hover { color: var(--lg-on-primary-container); }

  .guide__sections { padding-top: 20px; }
  .guide__section { scroll-margin-top: 92px; padding: 64px 0 30px; border-bottom: 1px solid var(--lg-outline-variant); }
  .guide__section:last-child { border-bottom: 0; }
  .guide__section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
  .guide__section-heading > div { max-width: 720px; }
  .guide__section h2 { font-size: clamp(28px, 4vw, 38px); line-height: 1.18; letter-spacing: -.9px; }
  .guide__section-heading p { margin: 12px 0 0; color: var(--lg-on-surface-variant); font-size: 17px; line-height: 1.65; }
  .guide__badge { display: inline-flex; margin-bottom: 12px; padding: 5px 9px; border-radius: 9px; background: var(--lg-primary-container); color: var(--lg-on-primary-container); font-size: 11px; font-weight: 800; letter-spacing: .55px; }
  .guide__top-link { flex: none; padding: 8px 0; color: var(--lg-on-surface-subtle); font-size: 13px; font-weight: 700; }

  .guide__steps { display: grid; gap: 12px; margin: 28px 0 0; padding: 0; list-style: none; }
  .guide__steps li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; padding: 17px 20px 17px 16px; border: 1px solid var(--lg-outline-variant); border-radius: 18px; background: var(--lg-surface); color: var(--lg-on-surface-variant); line-height: 1.62; }
  .guide__step-number { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 12px; background: var(--lg-primary-container); color: var(--lg-on-primary); font: 700 15px var(--lg-font-display); }
  .guide__steps li > div { padding-top: 5px; }

  .guide__notes { margin-top: 18px; padding: 20px 22px; border-left: 4px solid var(--lg-primary); border-radius: 4px 18px 18px 4px; background: var(--lg-surface-container); color: var(--lg-on-surface-variant); }
  .guide__notes strong { color: var(--lg-on-background); font-family: var(--lg-font-display); }
  .guide__notes ul { margin: 8px 0 0; padding-left: 20px; }
  .guide__notes li + li { margin-top: 6px; }

  .guide__widget-demo { display: grid; justify-items: center; gap: 15px; margin: 30px 0 8px; }
  .guide__phone { width: min(100%, 382px); padding: 10px; border-radius: 39px; background: var(--lg-surface-inverse); box-shadow: 0 24px 50px -28px rgba(36, 28, 22, .7); }
  .guide__phone img { width: 100%; border-radius: 30px; }
  .guide__widget-demo figcaption { max-width: 540px; color: var(--lg-on-surface-subtle); font-size: 14px; line-height: 1.55; text-align: center; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  [hidden] { display: none !important; }

  @media (max-width: 720px) {
    .guide { padding-top: 34px; }
    .guide__hero { padding: 26px 22px 32px; }
    .guide__language { margin-bottom: 34px; }
    .guide__hero-copy h1 { letter-spacing: -1.7px; }
    .guide__contents { grid-template-columns: 1fr; gap: 24px; }
    .guide__contents ol { grid-template-columns: 1fr; }
    .guide__section { padding-top: 52px; }
    .guide__section-heading { display: block; }
    .guide__top-link { display: inline-block; margin-top: 12px; }
  }

  @media (max-width: 440px) {
    .guide__steps li { grid-template-columns: 34px 1fr; gap: 10px; padding: 14px 14px 14px 12px; }
    .guide__step-number { width: 32px; height: 32px; border-radius: 10px; }
    .guide__steps li > div { padding-top: 3px; }
    .guide__phone { width: 100%; border-radius: 30px; }
    .guide__phone img { border-radius: 22px; }
  }
</style>
