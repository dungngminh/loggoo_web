---
import '../styles/global.css';
import { site } from '../data/site';
import Logo from '../components/Logo.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>frame studio · {site.name}</title>
    <meta name="description" content="Author a loggoo frame pack: place photo slots and an optional mood face, export a zip, and commit it to loggoo_asset." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FBF6F0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <!-- the five fonts a text bind can pick, so the canvas previews the app's rendering -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Caveat:wght@400;600&family=Sacramento&family=Baloo+2:wght@400;600&family=Playfair+Display:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="studio-nav">
      <a href="/" class="studio-nav__brand" aria-label="loggoo home"><Logo size={30} /></a>
      <p class="studio-nav__title">frame studio</p>
      <p class="studio-nav__note">export zip → commit to loggoo_asset</p>
    </header>

    <div id="studio" class="studio">
      <aside class="studio__side">
        <label class="field">
          <span>name · en</span>
          <input name="nameEn" type="text" placeholder="scrapbook" autocomplete="off" />
        </label>
        <label class="field">
          <span>name · vi</span>
          <input name="nameVi" type="text" placeholder="sổ dán" autocomplete="off" />
        </label>
        <div class="studio__row">
          <p class="studio__id">id · <code data-id>—</code></p>
          <button class="btn btn--ghost btn--sm" type="button" data-reset>start over</button>
        </div>
        <label class="check">
          <input name="premium" type="checkbox" checked />
          <span>loggoo plus</span>
        </label>
        <label class="field">
          <span>schema · app version</span>
          <select name="schemaVersion">
            <option value="4">v4 · app 1.5.1 and up</option>
            <option value="3">v3 · app 1.5.0</option>
            <option value="2">v2 · app 1.4.1 and below</option>
          </select>
        </label>
        <p class="studio__hint" data-schema-hint hidden>v3 has no background, logo, or text width / rotation / max lines / align. v2 also paints in a fixed order: overlay, photos, mood.</p>

        <div class="studio__block">
          <div class="studio__row">
            <p class="studio__label">overlay for this aspect</p>
            <button class="btn btn--ghost btn--sm" type="button" data-remove-overlay hidden>remove overlay</button>
          </div>
          <p class="studio__hint">png, jpg, or jpeg. use png if the holes should be transparent.</p>
          <label class="file">
            <input data-overlay-file type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" />
            <span>upload png / jpg</span>
          </label>
          <label class="file">
            <input data-icon-file type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" />
            <span>rail icon (optional)</span>
          </label>
          <p class="studio__hint">icon: square png, 256×256 recommended (min 128), transparent background, line art with ~2px strokes at 34px — it shows at 40dp in the rail.</p>
          <p class="studio__hint" data-icon-status></p>
        </div>

        <div class="studio__block" data-min-schema="4">
          <div class="studio__row">
            <p class="studio__label">background · optional</p>
            <button class="btn btn--ghost btn--sm" type="button" data-remove-background hidden>remove</button>
          </div>
          <p class="studio__hint">paints under everything for this aspect. a colour or a full-bleed image; picking one replaces the other.</p>
          <div class="studio__row studio__row--start">
            <label class="swatch-pick">
              <input data-background-color type="color" value="#FBF6F0" aria-label="background colour" />
              <span>colour</span>
            </label>
            <label class="file file--inline">
              <input data-background-file type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" />
              <span>image</span>
            </label>
          </div>
          <p class="studio__hint" data-background-status>none · the app paints its own surface</p>
        </div>

        <div class="studio__block">
          <div class="studio__row">
            <p class="studio__label">mood face · optional</p>
            <button class="btn btn--ghost btn--sm" type="button" data-add-sticker="mood">add mood face</button>
            <button class="btn btn--ghost btn--sm" type="button" data-delete-sticker="mood" hidden>delete mood</button>
          </div>
          <p class="studio__hint" data-sticker-status="mood">not used in this aspect</p>
        </div>

        <div class="studio__block" data-min-schema="4">
          <div class="studio__row">
            <p class="studio__label">loggoo icon · optional</p>
            <button class="btn btn--ghost btn--sm" type="button" data-add-sticker="logo">add loggoo icon</button>
            <button class="btn btn--ghost btn--sm" type="button" data-delete-sticker="logo" hidden>delete icon</button>
          </div>
          <p class="studio__hint" data-sticker-status="logo">not used in this aspect</p>
          <div class="aspect-toggle aspect-toggle--wrap" role="group" aria-label="logo style">
            <button type="button" data-logo-style="tile" hidden title="mark on the dark brand tile">tile</button>
            <button type="button" data-logo-style="dark" hidden title="bare brown mark · for light artwork">dark mark</button>
            <button type="button" data-logo-style="light" hidden title="bare cream mark · for dark artwork">light mark</button>
          </div>
        </div>

        <div class="studio__block">
          <div class="studio__row">
            <p class="studio__label">note text · optional</p>
            <button class="btn btn--ghost btn--sm" type="button" data-add-text>add note text</button>
          </div>
          <p class="studio__hint" data-min-schema="4">the day's note, wrapped inside a box you drag, widen, and rotate on the canvas. always paints on top.</p>
          <p class="studio__hint" data-max-schema="3">the day's note at a point on the canvas. always paints on top.</p>
          <div class="inspector" data-text-inspector hidden>
            <label class="field">
              <span>font</span>
              <select data-text-font>
                <option value="poppins">poppins</option>
                <option value="caveat">caveat</option>
                <option value="sacramento">sacramento</option>
                <option value="baloo">baloo</option>
                <option value="playfair">playfair</option>
              </select>
            </label>
            <div class="inspector__grid">
              <label class="field">
                <span>size · sp</span>
                <input data-text-size type="number" min="4" max="200" step="1" />
              </label>
              <label class="field" data-min-schema="4">
                <span>max lines</span>
                <input data-text-lines type="number" min="1" max="20" step="1" />
              </label>
            </div>
            <div class="inspector__grid">
              <label class="field" data-min-schema="4">
                <span>align</span>
                <select data-text-align>
                  <option value="start">start</option>
                  <option value="center">center</option>
                  <option value="end">end</option>
                </select>
              </label>
              <label class="field">
                <span>colour</span>
                <input data-text-color type="color" />
              </label>
            </div>
            <button class="btn btn--ghost btn--sm" type="button" data-delete-text>delete note text</button>
          </div>
        </div>

        <div class="studio__block">
          <div class="studio__row">
            <p class="studio__label">layers · top first</p>
            <button class="btn btn--ghost btn--sm" type="button" data-add-slot>add slot</button>
          </div>
          <p class="studio__hint">click a row to select it · ▲ ▼ change what paints on top. note text is pinned above, background below.</p>
          <div class="layer-list" data-layer-list></div>
          <div class="inspector" data-inspector hidden>
            <label class="field">
              <span>photo index</span>
              <input data-slot-photo type="number" min="1" step="1" />
            </label>
            <div class="studio__row">
              <label class="field">
                <span>width · dp</span>
                <input data-slot-w type="number" min="1" step="1" />
              </label>
              <label class="field">
                <span>height · dp</span>
                <input data-slot-h type="number" min="1" step="1" />
              </label>
            </div>
            <label class="check">
              <input data-slot-lock type="checkbox" />
              <span>lock aspect ratio</span>
            </label>
            <button class="btn btn--ghost btn--sm" type="button" data-delete-slot>delete slot</button>
          </div>
        </div>

        <div class="studio__block">
          <button class="btn btn--primary" type="button" data-export>export zip</button>
          <p class="studio__hint" data-status></p>
          <label class="field">
            <span>catalog.json snippet</span>
            <textarea data-snippet rows="8" readonly placeholder="appears here after a successful export"></textarea>
          </label>
        </div>
      </aside>

      <section class="studio__stage">
        <div class="studio__toolbar">
          <div class="aspect-toggle" role="tablist" aria-label="frame aspect">
            <button class="is-active" type="button" data-aspect="story">story 9:16</button>
            <button type="button" data-aspect="post">post 4:5</button>
          </div>
          <div class="aspect-toggle" role="tablist" aria-label="canvas mode">
            <button class="is-active" type="button" data-mode="select">select</button>
            <button type="button" data-mode="draw">draw slot</button>
          </div>
          <div class="aspect-toggle" aria-label="canvas helpers">
            <button type="button" data-helper="grid" aria-pressed="false">grid</button>
            <button type="button" data-helper="safe" aria-pressed="false">safe area</button>
          </div>
          <p class="studio__zoom" title="⌘/Ctrl + · − · 0 or ⌘/Ctrl + wheel / pinch to zoom · ⌘/Ctrl Z undo · ⇧⌘/Ctrl Z redo">zoom <span data-zoom>100%</span></p>
        </div>
        <p class="studio__stage-hint" data-mode-hint>
          select: click the frame, a slot, or the mood · move / resize · top knob rotates · inner dot rounds photo corners ·
          <span data-aspect-label>9:16 story</span>
        </p>
        <div class="stage">
          <div class="frame" data-frame data-aspect="story">
            <p class="frame__empty" data-overlay-empty>upload a story overlay</p>
            <img class="frame__background" data-background alt="" hidden data-min-schema="4" />
            <img class="frame__overlay" data-overlay alt="" hidden />
            <div class="frame__slots" data-slots></div>
            <div class="frame__mood" data-stickers></div>
            <div class="frame__texts" data-texts></div>
            <div class="frame__rubber" data-rubber hidden></div>
            <div class="frame__grid" aria-hidden="true"></div>
            <div class="frame__safe" aria-hidden="true"></div>
            <div class="frame__guide frame__guide--v" data-guide="v" hidden></div>
            <div class="frame__guide frame__guide--h" data-guide="h" hidden></div>
          </div>
        </div>
      </section>
    </div>

    <div class="ctx" data-ctx role="menu" hidden>
      <button type="button" role="menuitem" data-ctx-action="duplicate">duplicate <kbd>⌘D</kbd></button>
      <button type="button" role="menuitem" data-ctx-action="up">bring forward</button>
      <button type="button" role="menuitem" data-ctx-action="down">send backward</button>
      <button type="button" role="menuitem" class="is-danger" data-ctx-action="delete">delete <kbd>⌫</kbd></button>
    </div>

    <div class="toasts" data-toasts aria-live="polite" aria-relevant="additions"></div>

    <script>
      import { mountStudio } from '../scripts/frame-studio'
      mountStudio(document.getElementById('studio')!)
    </script>
  </body>
</html>

<style is:global>
  html:has(.studio),
  body:has(.studio) {
    height: 100%;
    overflow: hidden;
  }
  body:has(.studio) {
    display: flex;
    flex-direction: column;
    overscroll-behavior: none;
  }
  .studio-nav {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 22px;
    border-bottom: 1px solid var(--lg-outline-variant);
    background: color-mix(in srgb, var(--lg-background) 88%, transparent);
    flex: none;
  }
  .studio-nav__title {
    margin: 0;
    font-family: var(--lg-font-display);
    font-weight: 700;
    font-size: 16px;
  }
  .studio-nav__note {
    margin: 0 0 0 auto;
    font-size: 12.5px;
    color: var(--lg-on-surface-muted);
  }
  .studio {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
  }
  .studio__side {
    padding: 20px 18px 32px;
    border-right: 1px solid var(--lg-outline-variant);
    background: var(--lg-surface);
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: auto;
    min-height: 0;
    scrollbar-gutter: stable;
  }
  .studio__side > * { flex-shrink: 0; }
  /* Older schemas never had these controls: v3 lacks background / logo / text box fields, v2 also lacks layer order. */
  .studio[data-schema="2"] [data-min-schema="3"],
  .studio[data-schema="2"] [data-min-schema="4"],
  .studio[data-schema="3"] [data-min-schema="4"],
  .studio[data-schema="4"] [data-max-schema="3"] { display: none !important; }
  .studio__stage {
    padding: 18px 22px 22px;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
  .studio__block { display: flex; flex-direction: column; gap: 10px; }
  .studio__row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .studio__row > .field { flex: 1; min-width: 0; }
  .studio__label {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .6px;
    text-transform: uppercase;
    color: var(--lg-on-surface-muted);
  }
  .studio__hint {
    margin: 0;
    font-size: 13px;
    color: var(--lg-on-surface-subtle);
    line-height: 1.45;
    min-height: 1.45em;
  }
  .studio__id {
    margin: -4px 0 0;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--lg-on-surface-muted);
  }
  .studio__id code {
    font-family: ui-monospace, monospace;
    font-weight: 600;
    color: var(--lg-on-surface-variant);
  }
  .studio__toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .studio__zoom {
    margin: 0 0 0 auto;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--lg-on-surface-muted);
    cursor: help;
  }
  .studio__stage-hint {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--lg-on-surface-subtle);
  }
  .field { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: var(--lg-on-surface-variant); }
  .field em { font-style: normal; font-weight: 600; color: var(--lg-on-surface-subtle); float: right; }
  .field input[type="text"],
  .field input[type="number"],
  .field select,
  .field textarea {
    font: inherit;
    font-weight: 600;
    color: var(--lg-on-background);
    background: var(--lg-background);
    border: 1px solid var(--lg-outline);
    border-radius: 14px;
    padding: 10px 12px;
  }
  .field textarea { font-family: ui-monospace, monospace; font-size: 11.5px; font-weight: 500; resize: vertical; }
  .field input.is-invalid,
  .field textarea.is-invalid {
    border-color: var(--lg-error);
    background: color-mix(in srgb, var(--lg-error) 8%, var(--lg-background));
  }
  .ctx {
    position: fixed;
    /* above the lifted selection (z 100) and the rubber band (z 200), which sort at the root since .stage makes no stacking context */
    z-index: 300;
    display: flex;
    flex-direction: column;
    min-width: 172px;
    padding: 6px;
    border-radius: 12px;
    background: var(--lg-surface);
    box-shadow: 0 14px 30px -14px rgba(74, 55, 40, .5), 0 0 0 1px color-mix(in srgb, var(--lg-secondary) 30%, transparent);
  }
  .ctx button {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border: 0;
    background: transparent;
    padding: 8px 10px;
    border-radius: 8px;
    text-align: left;
    font-family: var(--lg-font-display);
    font-weight: 700;
    font-size: 13px;
    color: var(--lg-on-background);
    cursor: pointer;
  }
  .ctx button:hover, .ctx button:focus-visible { background: var(--lg-surface-dim); outline: none; }
  .ctx button.is-danger { color: var(--lg-error); }
  .ctx[hidden] { display: none; }
  .ctx kbd { font: inherit; font-weight: 600; color: var(--lg-on-surface-subtle); }
  .toasts {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 22px;
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    pointer-events: none;
    padding: 0 20px;
  }
  .toast {
    pointer-events: auto;
    max-width: 420px;
    width: min(100%, 420px);
    padding: 16px 20px;
    border-radius: 999px;
    font-family: var(--lg-font-body);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
    box-shadow: 0 16px 28px -18px rgba(74, 55, 40, .55);
    animation: toast-in .22s ease;
  }
  .toast.is-leaving { animation: toast-out .2s ease forwards; }
  .toast--error { background: var(--lg-error); color: var(--lg-on-error); }
  .toast--success { background: var(--lg-primary); color: var(--lg-on-primary); }
  .toast--info { background: var(--lg-on-background); color: var(--lg-background); }
  @keyframes toast-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes toast-out { to { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) {
    .toast, .toast.is-leaving { animation: none; }
  }
  .check { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; }
  .file { position: relative; }
  .file--inline { flex: 1; }
  .file--inline span { padding: 7px 10px; }
  .file input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .file span {
    display: flex; justify-content: center;
    padding: 10px; border-radius: 14px;
    border: 1px dashed var(--lg-outline);
    background: var(--lg-background);
    font-size: 13px; font-weight: 700;
    color: var(--lg-on-primary-container);
  }
  .aspect-toggle {
    display: inline-flex;
    gap: 6px;
    padding: 4px;
    border-radius: 16px;
    background: var(--lg-surface-dim);
    width: max-content;
  }
  .aspect-toggle button {
    border: 0;
    background: transparent;
    padding: 8px 14px;
    border-radius: 12px;
    font-family: var(--lg-font-display);
    font-weight: 700;
    font-size: 13.5px;
    color: var(--lg-on-surface-variant);
    cursor: pointer;
  }
  .aspect-toggle button.is-active {
    background: var(--lg-surface);
    color: var(--lg-on-background);
  }
  .stage {
    flex: 1;
    min-height: 0;
    display: flex;
    overflow: auto;
    padding: 16px 0 0;
    container-type: size;
  }
  .frame {
    /* margin auto centers while the frame fits and pins it to the start once zoom overflows, so every edge stays scrollable */
    margin: auto;
    flex: none;
    position: relative;
    aspect-ratio: 9 / 16;
    width: calc(min(100cqw, calc(100cqh * 9 / 16)) * var(--zoom, 1));
    height: calc(min(100cqh, calc(100cqw * 16 / 9)) * var(--zoom, 1));
    cursor: crosshair;
    background: var(--lg-surface-container);
    border-radius: 18px;
    overflow: visible;
    box-shadow: 0 22px 40px -24px rgba(74, 55, 40, .55);
    touch-action: none;
    user-select: none;
    /* children size text in cqw so sp scales with the canvas and zoom */
    container-type: inline-size;
  }
  .frame[data-aspect="post"] {
    aspect-ratio: 4 / 5;
    width: calc(min(100cqw, calc(100cqh * 4 / 5)) * var(--zoom, 1));
    height: calc(min(100cqh, calc(100cqw * 5 / 4)) * var(--zoom, 1));
  }
  .frame__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: fill;
    pointer-events: none;
    border-radius: 18px;
    /* z-index comes inline from the layer order; the selected layer lifts to 100 so handles stay grabbable */
  }
  .frame.is-frame-selected .frame__overlay {
    outline: 2.5px solid var(--lg-secondary);
    outline-offset: -2.5px;
  }
  .frame__overlay[hidden] { display: none !important; }
  .frame__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: fill;
    pointer-events: none;
    border-radius: 18px;
    z-index: 1;
  }
  .frame__background[hidden] { display: none !important; }
  .frame__empty {
    display: none;
    margin: 0;
    position: absolute;
    inset: 0;
    place-items: center;
    font-family: var(--lg-font-display);
    font-size: 14px;
    font-weight: 700;
    color: var(--lg-on-surface-muted);
    pointer-events: none;
  }
  .frame:not(.has-overlay) .frame__empty { display: grid; }
  .frame__slots, .frame__mood, .frame__texts, .frame__rubber { position: absolute; inset: 0; pointer-events: none; }
  /* Helpers sit above everything but never catch the pointer. Grid cells are 20dp on the 360dp design canvas. */
  .frame__grid, .frame__safe, .frame__guide { position: absolute; pointer-events: none; z-index: 190; display: none; }
  .frame__grid {
    inset: 0;
    --cell: calc(100cqw * 20 / 360);
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--lg-secondary) 35%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--lg-secondary) 35%, transparent) 1px, transparent 1px);
    background-size: var(--cell) var(--cell);
  }
  .frame__safe {
    inset: var(--safe-y, 0) var(--safe-x, 0);
    border: 1.5px dashed color-mix(in srgb, var(--lg-secondary) 75%, transparent);
    box-shadow: 0 0 0 100vmax color-mix(in srgb, var(--lg-on-mood) 18%, transparent);
    clip-path: inset(calc(-1 * var(--safe-y, 0)) calc(-1 * var(--safe-x, 0)));
  }
  .frame__guide { background: var(--lg-primary); }
  .frame__guide--v { top: 0; bottom: 0; width: 1.5px; transform: translateX(-50%); }
