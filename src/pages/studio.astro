---
import '../styles/global.css';
import { site } from '../data/site';
import Logo from '../components/Logo.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>frame studio · {site.name}</title>
    <meta name="description" content="Author a loggoo frame pack: place photo slots and an optional mood face, export a zip, and commit it to loggoo_asset." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FBF6F0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <!-- the five fonts a text bind can pick, so the canvas previews the app's rendering -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Caveat:wght@400;600&family=Sacramento&family=Baloo+2:wght@400;600&family=Playfair+Display:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="studio" class="studio" data-selection="none">
      <header class="topbar">
        <div class="topbar__left">
          <a href="/" class="topbar__brand" aria-label="loggoo home"><Logo size={24} /></a>
          <div class="topbar__file">
            <input class="topbar__name" name="nameEn" type="text" placeholder="pack name · en" autocomplete="off" aria-label="pack name (english)" />
            <p class="topbar__id">id · <code data-id>—</code> <span class="topbar__saved" data-saved></span></p>
          </div>
          <div class="tools tools--history" role="group" aria-label="history">
            <button class="tool" type="button" data-undo disabled title="undo · ⌘/Ctrl Z" aria-label="undo">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 5.5L4 9l3.5 3.5M4.5 9h7a4 4 0 0 1 0 8H9" fill="none" /></svg>
            </button>
            <button class="tool" type="button" data-redo disabled title="redo · ⇧⌘/Ctrl Z" aria-label="redo">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 5.5L16 9l-3.5 3.5M15.5 9h-7a4 4 0 0 0 0 8H11" fill="none" /></svg>
            </button>
          </div>
        </div>

        <div class="tools" role="toolbar" aria-label="tools">
          <button class="tool is-active" type="button" data-mode="select" title="select · click the frame, a slot, a sticker, or the note" aria-label="select">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3l11 7.5-4.8 1 2.6 4.6-2 1.1-2.6-4.6L6 16z" /></svg>
          </button>
          <button class="tool" type="button" data-mode="draw" title="draw photo slot · drag a hole on the canvas" aria-label="draw photo slot">
            <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3.5" y="3.5" width="13" height="13" rx="1.5" fill="none" /><path d="M6.5 13l3-3.5 2 2.2 1.6-1.6 2.4 2.9" fill="none" /></svg>
          </button>
          <button class="tool" type="button" data-add-slot title="add photo slot · centred default box" aria-label="add photo slot">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" fill="none" /></svg>
          </button>
          <span class="tools__sep" aria-hidden="true"></span>
          <button class="tool" type="button" data-add-text title="add note text" aria-label="add note text">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 5h12M10 5v11M7.5 16h5" fill="none" /></svg>
          </button>
          <button class="tool" type="button" data-add-sticker="mood" title="add mood face" aria-label="add mood face">
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" fill="none" /><path d="M6.8 8.2c.6-1 1.8-1 2.4 0M10.8 8.2c.6-1 1.8-1 2.4 0M7 12c1.4 2 4.6 2 6 0" fill="none" /></svg>
          </button>
          <button class="tool" type="button" data-add-sticker="logo" data-min-schema="4" title="add loggoo icon" aria-label="add loggoo icon">
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="7.8" cy="11" r="4" fill="none" /><circle cx="12.2" cy="11" r="4" fill="none" /><circle cx="15" cy="5" r="1.8" stroke="none" /></svg>
          </button>
        </div>

        <div class="topbar__right">
          <div class="seg" aria-label="canvas helpers">
            <button type="button" data-helper="grid" aria-pressed="false" title="20dp grid">grid</button>
            <button type="button" data-helper="safe" aria-pressed="false" title="safe area">safe</button>
          </div>
          <button class="tool tool--preview" type="button" data-preview aria-pressed="false" title="preview · render like the app, with placeholder photos" aria-label="preview">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4.5v11l9-5.5z" /></svg>
          </button>
          <p class="topbar__zoom" title="⌘/Ctrl + · − · 0 or ⌘/Ctrl + wheel / pinch to zoom · ⌘/Ctrl Z undo · ⇧⌘/Ctrl Z redo"><span data-zoom>100%</span></p>
          <button class="btn btn--ghost btn--sm" type="button" data-reset>start over</button>
          <button class="btn btn--primary btn--sm" type="button" data-export>export zip</button>
        </div>
      </header>

      <aside class="panel panel--left">
        <section class="panel__section">
          <h2 class="panel__title">pages</h2>
          <div class="pages" role="tablist" aria-label="frame aspect">
            <button class="page is-active" type="button" data-aspect="story"><span class="page__dot"></span>story · 9:16</button>
            <button class="page" type="button" data-aspect="post"><span class="page__dot"></span>post · 4:5</button>
          </div>
        </section>

        <section class="panel__section">
          <h2 class="panel__title">pack</h2>
          <div class="panel__body">
          <label class="field">
            <span>name · vi</span>
            <input name="nameVi" type="text" placeholder="sổ dán" autocomplete="off" />
          </label>
          <label class="check">
            <input name="premium" type="checkbox" checked />
            <span>loggoo plus</span>
          </label>
          <label class="field">
            <span>schema · app version</span>
            <select name="schemaVersion">
              <option value="4">v4 · app 1.5.1 and up</option>
              <option value="3">v3 · app 1.5.0</option>
              <option value="2">v2 · app 1.4.1 and below</option>
            </select>
          </label>
          <p class="panel__hint" data-schema-hint hidden>v3 has no background, logo, or text width / rotation / max lines / align. v2 also paints in a fixed order: overlay, photos, mood.</p>
          <label class="file">
            <input data-icon-file type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" />
            <span>rail icon (optional)</span>
          </label>
          <p class="panel__hint">square png, 256×256 recommended (min 128), transparent background, ~2px line art at 34px — shows at 40dp in the rail.</p>
          <p class="panel__hint" data-icon-status></p>
          </div>
        </section>
        <section class="panel__section panel__section--grow">
          <h2 class="panel__title">layers</h2>
          <p class="panel__hint">top first · drag or ▲ ▼ to reorder · note pinned above, background below</p>
          <div class="layer-list" data-layer-list></div>
        </section>

      </aside>

      <section class="canvas">
        <div class="stage">
          <div class="frame" data-frame data-aspect="story">
            <p class="frame__empty" data-overlay-empty>upload a story overlay</p>
            <img class="frame__background" data-background alt="" hidden data-min-schema="4" />
            <img class="frame__overlay" data-overlay alt="" hidden />
            <div class="frame__slots" data-slots></div>
            <div class="frame__mood" data-stickers></div>
            <div class="frame__texts" data-texts></div>
            <div class="frame__rubber" data-rubber hidden></div>
            <div class="frame__grid" aria-hidden="true"></div>
            <div class="frame__safe" aria-hidden="true"></div>
            <div class="frame__guide frame__guide--v" data-guide="v" hidden></div>
            <div class="frame__guide frame__guide--h" data-guide="h" hidden></div>
          </div>
        </div>
        <p class="canvas__status" data-mode-hint>select: click the frame, a slot, a sticker, or the note · move / resize · top knob rotates · inner dot rounds photo corners · <span data-aspect-label>9:16 story</span></p>
      </section>

      <aside class="panel panel--right">
        <h2 class="panel__title panel__title--tab">design</h2>

        <section class="panel__section" data-panel="aspect">
          <div class="panel__row">
            <h3 class="panel__label">overlay</h3>
            <button class="btn btn--ghost btn--xs" type="button" data-remove-overlay hidden>remove</button>
          </div>
          <label class="file">
            <input data-overlay-file type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" />
            <span>upload png / jpg</span>
          </label>
          <p class="panel__hint">png keeps the holes transparent. optional on v4.</p>
        </section>

        <section class="panel__section" data-panel="aspect" data-min-schema="4">
          <div class="panel__row">
            <h3 class="panel__label">background</h3>
            <button class="btn btn--ghost btn--xs" type="button" data-remove-background hidden>remove</button>
          </div>
          <div class="panel__row panel__row--start">
            <label class="swatch-pick">
              <input data-background-color type="color" value="#FBF6F0" aria-label="background colour" />
              <span>colour</span>
            </label>
            <label class="file file--inline">
              <input data-background-file type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" />
              <span>image</span>
            </label>
          </div>
          <p class="panel__hint" data-background-status>none · the app paints its own surface</p>
        </section>

        <section class="panel__section inspector" data-panel="slot" data-inspector hidden>
          <h3 class="panel__label">photo slot</h3>
          <div class="props">
            <label class="prop"><span>X</span><input data-slot-x type="number" step="1" aria-label="x · dp" /></label>
            <label class="prop"><span>Y</span><input data-slot-y type="number" step="1" aria-label="y · dp" /></label>
            <label class="prop"><span>W</span><input data-slot-w type="number" min="1" step="1" aria-label="width · dp" /></label>
            <label class="prop"><span>H</span><input data-slot-h type="number" min="1" step="1" aria-label="height · dp" /></label>
            <label class="prop"><span>↻</span><input data-slot-rotation type="number" min="-45" max="45" step="1" aria-label="rotation · degrees" /></label>
            <label class="prop"><span>◜</span><input data-slot-corner type="number" min="0" max="24" step="1" aria-label="corner radius · dp" /></label>
          </div>
          <label class="check">
            <input data-slot-lock type="checkbox" />
            <span>lock aspect ratio</span>
          </label>
          <h3 class="panel__label">photo</h3>
          <div class="props">
            <label class="prop"><span>#</span><input data-slot-photo type="number" min="1" step="1" aria-label="photo index" /></label>
          </div>
          <p class="panel__hint">dp on the 360dp design canvas · rotation −45..45 · radius 0..24</p>
          <button class="btn btn--ghost btn--xs is-danger" type="button" data-delete-slot>delete slot</button>
        </section>

        <section class="panel__section inspector" data-panel="sticker" data-sticker-inspector hidden>
          <h3 class="panel__label"><span data-sticker-status="mood">mood face</span><span data-sticker-status="logo">loggoo icon</span></h3>
          <div class="props">
            <label class="prop"><span>X</span><input data-sticker-x type="number" step="1" aria-label="x · dp" /></label>
            <label class="prop"><span>Y</span><input data-sticker-y type="number" step="1" aria-label="y · dp" /></label>
            <label class="prop"><span>S</span><input data-sticker-size type="number" min="16" max="180" step="1" aria-label="size · dp" /></label>
            <label class="prop"><span>↻</span><input data-sticker-rotation type="number" min="-45" max="45" step="1" aria-label="rotation · degrees" /></label>
          </div>
          <div class="seg seg--full" role="group" aria-label="logo style">
            <button type="button" data-logo-style="tile" hidden title="mark on the dark brand tile">tile</button>
            <button type="button" data-logo-style="dark" hidden title="bare brown mark · for light artwork">dark</button>
            <button type="button" data-logo-style="light" hidden title="bare cream mark · for dark artwork">light</button>
          </div>
          <p class="panel__hint">the app draws the day's top mood here; the logo previews the chosen style.</p>
          <button class="btn btn--ghost btn--xs is-danger" type="button" data-delete-sticker="mood" hidden>delete mood face</button>
          <button class="btn btn--ghost btn--xs is-danger" type="button" data-delete-sticker="logo" hidden>delete loggoo icon</button>
        </section>

        <section class="panel__section inspector" data-panel="text" data-text-inspector hidden>
          <h3 class="panel__label">note text</h3>
          <div class="props">
            <label class="prop"><span>X</span><input data-text-x type="number" step="1" aria-label="x · dp" /></label>
            <label class="prop"><span>Y</span><input data-text-y type="number" step="1" aria-label="y · dp" /></label>
            <label class="prop" data-min-schema="4"><span>W</span><input data-text-w type="number" min="18" step="1" aria-label="width · dp" /></label>
            <label class="prop" data-min-schema="4"><span>↻</span><input data-text-rotation type="number" min="-45" max="45" step="1" aria-label="rotation · degrees" /></label>
          </div>
          <h3 class="panel__label">typography</h3>
          <label class="field">
            <span>font</span>
            <select data-text-font>
              <option value="poppins">poppins</option>
              <option value="caveat">caveat</option>
              <option value="sacramento">sacramento</option>
              <option value="baloo">baloo</option>
              <option value="playfair">playfair</option>
            </select>
          </label>
          <div class="props">
            <label class="prop"><span>sp</span><input data-text-size type="number" min="4" max="200" step="1" aria-label="size · sp" /></label>
            <label class="prop" data-min-schema="4"><span>≡</span><input data-text-lines type="number" min="1" max="20" step="1" aria-label="max lines" /></label>
          </div>
          <div class="props">
            <label class="field" data-min-schema="4">
              <span>align</span>
              <select data-text-align>
                <option value="start">start</option>
                <option value="center">center</option>
                <option value="end">end</option>
              </select>
            </label>
            <label class="field">
              <span>colour</span>
              <input data-text-color type="color" />
            </label>
          </div>
          <p class="panel__hint" data-min-schema="4">the day's note wraps inside the box and is cut with an ellipsis after max lines. always paints on top.</p>
          <p class="panel__hint" data-max-schema="3">the day's note at a point on the canvas. always paints on top.</p>
          <button class="btn btn--ghost btn--xs is-danger" type="button" data-delete-text>delete note text</button>
        </section>

        <section class="panel__section" data-panel="export">
          <h3 class="panel__label">export</h3>
          <p class="panel__hint" data-status>export zip → unzip into loggoo_asset/frames/&lt;id&gt;/</p>
          <label class="field">
            <span>catalog.json snippet</span>
            <textarea data-snippet rows="7" readonly placeholder="appears here after a successful export"></textarea>
          </label>
        </section>
      </aside>
    </div>

    <div class="ctx" data-ctx role="menu" hidden>
      <button type="button" role="menuitem" data-ctx-action="duplicate">duplicate <kbd>⌘D</kbd></button>
      <button type="button" role="menuitem" data-ctx-action="up">bring forward</button>
      <button type="button" role="menuitem" data-ctx-action="down">send backward</button>
      <button type="button" role="menuitem" class="is-danger" data-ctx-action="delete">delete <kbd>⌫</kbd></button>
    </div>

    <div class="toasts" data-toasts aria-live="polite" aria-relevant="additions"></div>

    <script>
      import { mountStudio } from '../scripts/frame-studio'
      mountStudio(document.getElementById('studio')!)
    </script>
  </body>
</html>

<style is:global>
  html:has(.studio),
  body:has(.studio) {
    height: 100%;
    overflow: hidden;
  }
  body:has(.studio) { overscroll-behavior: none; }

  /* Figma-style shell: 48px toolbar, then layers | canvas | design */
  .studio {
    height: 100%;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 260px;
    grid-template-rows: 48px minmax(0, 1fr);
    grid-template-areas: 'top top top' 'left canvas right';
    background: var(--lg-surface);
    color: var(--lg-on-background);
  }
  /* Older schemas never had these controls: v3 lacks background / logo / text box fields, v2 also lacks layer order. */
  .studio[data-schema="2"] [data-min-schema="3"],
  .studio[data-schema="2"] [data-min-schema="4"],
  .studio[data-schema="3"] [data-min-schema="4"],
  .studio[data-schema="4"] [data-max-schema="3"] { display: none !important; }
  /* The design panel shows what the selection needs: aspect settings when nothing (or the frame / background) is picked. */
  .studio:not([data-selection="none"]):not([data-selection="frame"]):not([data-selection="background"]) [data-panel="aspect"],
  .studio:not([data-selection="slot"]) [data-panel="slot"],
  .studio:not([data-selection="sticker"]) [data-panel="sticker"],
  .studio:not([data-selection="text"]) [data-panel="text"] { display: none !important; }

  .topbar {
    grid-area: top;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 0 12px;
    border-bottom: 1px solid var(--lg-outline-variant);
    background: var(--lg-surface);
    min-width: 0;
  }
  .topbar__left { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .topbar__brand { display: inline-flex; flex: none; }
  .topbar__file { display: flex; flex-direction: column; min-width: 0; }
  .topbar__name {
    font: inherit;
    font-family: var(--lg-font-display);
    font-weight: 700;
    font-size: 14px;
    color: var(--lg-on-background);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 2px 6px;
    margin: 0 -6px;
    width: 220px;
    max-width: 100%;
  }
  .topbar__name:hover { border-color: var(--lg-outline-variant); }
  .topbar__name:focus { outline: none; border-color: var(--lg-secondary); background: var(--lg-background); }
  .topbar__name.is-invalid { border-color: var(--lg-error); }
  .topbar__id { margin: 0; font-size: 11px; font-weight: 700; color: var(--lg-on-surface-muted); white-space: nowrap; }
  .topbar__saved { margin-left: 6px; font-weight: 600; color: var(--lg-on-surface-subtle); }
  .topbar__saved:empty { display: none; }
  .tools--history { flex: none; }
  .tool:disabled { opacity: .3; cursor: default; background: transparent; }
  .topbar__id code { font-family: ui-monospace, monospace; font-weight: 600; color: var(--lg-on-surface-variant); }
  .topbar__right { display: flex; align-items: center; justify-content: flex-end; gap: 10px; min-width: 0; }
  .topbar__zoom { margin: 0; font-size: 12.5px; font-weight: 700; color: var(--lg-on-surface-muted); cursor: help; }

  .tools {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 12px;
    background: var(--lg-surface-dim);
  }
  .tools__sep { width: 1px; height: 20px; margin: 0 4px; background: var(--lg-outline-variant); }
  .tools__sep:not(:has(~ .tool:not([hidden]))) { display: none; }
  .tool {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--lg-on-surface-variant);
    cursor: pointer;
  }
  .tool svg { width: 20px; height: 20px; fill: currentColor; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .tool:hover { background: var(--lg-surface); color: var(--lg-on-background); }
  .tool.is-active { background: var(--lg-on-background); color: var(--lg-background); }
  .tool--preview { background: var(--lg-surface-dim); }
  .tool--preview.is-active { background: var(--lg-primary); color: var(--lg-on-primary); }

  .seg {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    background: var(--lg-surface-dim);
  }
  .seg--full { display: flex; }
  .seg--full:not(:has(button:not([hidden]))) { display: none; }
  .seg--full button { flex: 1; }
  .seg button {
    border: 0;
    background: transparent;
    padding: 5px 10px;
    border-radius: 8px;
    font-family: var(--lg-font-display);
    font-weight: 700;
    font-size: 12.5px;
    color: var(--lg-on-surface-variant);
    cursor: pointer;
  }
  .seg button.is-active { background: var(--lg-surface); color: var(--lg-on-background); }

  .panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: auto;
    background: var(--lg-surface);
    scrollbar-gutter: stable;
  }
  .panel--left { grid-area: left; border-right: 1px solid var(--lg-outline-variant); }
  .panel--right { grid-area: right; border-left: 1px solid var(--lg-outline-variant); }
  .panel__section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    border-bottom: 1px solid var(--lg-outline-variant);
    flex-shrink: 0;
  }
  .panel__section--grow { flex: 1; }
  .panel__title {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .6px;
    text-transform: uppercase;
    color: var(--lg-on-surface-muted);
  }
  .panel__title--tab {
    padding: 14px 12px 10px;
    border-bottom: 1px solid var(--lg-outline-variant);
    color: var(--lg-on-background);
  }
  .panel__body { display: flex; flex-direction: column; gap: 10px; }
  .panel__label {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    color: var(--lg-on-surface-variant);
  }
  .panel__row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .panel__row--start { justify-content: flex-start; gap: 12px; }
  .panel__hint {
    margin: 0;
    font-size: 12px;
    line-height: 1.4;
    color: var(--lg-on-surface-subtle);
  }
  .btn--xs { padding: 5px 10px; border-radius: 10px; font-size: 12px; align-self: flex-start; }
  .btn--xs.is-danger { color: var(--lg-error); }

  .pages { display: flex; flex-direction: column; gap: 2px; }
  .page {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 0;
    background: transparent;
    padding: 6px 8px;
    border-radius: 8px;
    font-family: var(--lg-font-display);
    font-weight: 700;
