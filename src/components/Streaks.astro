---
import Flame from './Flame.astro';
const week = ['m', 't', 'w', 't', 'f', 's', 's'];
---
<section class="streaks" id="streaks">
  <div class="wrap streaks__inner">
    <div>
      <p class="eyebrow streaks__eyebrow">THE HABIT</p>
      <h2 class="h2 streaks__title">a streak that stays kind.</h2>
      <p class="streaks__lead">one photo or one mood keeps the chain alive. miss a day and nothing is deleted, nothing turns red — the flame just waits for you to come back.</p>
      <dl class="streaks__stats">
        <div><dt>21:00</dt><dd>one nudge, at your hour</dd></div>
        <div><dt>~20s</dt><dd>to log a whole moment</dd></div>
        <div><dt>0</dt><dd>guilt screens, ever</dd></div>
      </dl>
    </div>

    <div class="streaks__panel">
      <div class="streaks__banner">
        <Flame size={30} />
        <div><strong>12 day streak</strong><em>don't break the chain</em></div>
      </div>
      <ol class="streaks__week">
        {week.map((d, i) => (
          <li class={i < 5 ? 'is-done' : i === 5 ? 'is-today' : ''}>{d}</li>
        ))}
      </ol>
      <p class="streaks__insight">this week leaned <strong>happy</strong> — your best stretch since june. thursday was your radiant day.</p>
    </div>
  </div>
</section>

<style>
  .streaks { margin-top: 88px; background: var(--lg-surface-inverse); padding: 70px 0; }
  .streaks__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .streaks__eyebrow { color: rgba(251,246,240,.45); }
  .streaks__title { color: var(--lg-background); margin-top: 12px; }
  .streaks__lead { font-size: 16.5px; line-height: 1.65; color: rgba(251,246,240,.72); margin: 16px 0 0; max-width: 460px; text-wrap: pretty; }
  .streaks__stats { display: flex; gap: 26px; flex-wrap: wrap; margin: 28px 0 0; }
  .streaks__stats dt { font-family: var(--lg-font-display); font-weight: 700; font-size: 30px; color: var(--lg-primary); }
  .streaks__stats dd { margin: 3px 0 0; font-size: 13px; color: rgba(251,246,240,.55); }

  .streaks__panel { background: rgba(251,246,240,.06); border: 1px solid rgba(251,246,240,.12); border-radius: var(--lg-radius-panel); padding: 26px; }
  .streaks__banner { display: flex; align-items: center; gap: 11px; }
  .streaks__banner strong { display: block; font-family: var(--lg-font-display); font-size: 19px; color: var(--lg-background); }
  .streaks__banner em { display: block; font-style: normal; font-size: 13px; color: rgba(251,246,240,.55); }
  .streaks__week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 7px; margin: 22px 0 0; padding: 0; list-style: none; }
  .streaks__week li {
    aspect-ratio: 1; border-radius: 14px; display: flex; align-items: center; justify-content: center;
    font-family: var(--lg-font-display); font-weight: 700; font-size: 13px;
    background: rgba(251,246,240,.1); color: rgba(251,246,240,.4);
  }
  .streaks__week .is-done { background: var(--lg-primary); color: var(--lg-on-primary); }
  .streaks__week .is-today { background: var(--lg-primary-container); color: var(--lg-on-primary-container); box-shadow: 0 0 0 2.5px var(--lg-primary-hover); }
  .streaks__insight {
    margin: 20px 0 0; padding: 15px 17px; border-radius: var(--lg-radius-tile);
    background: rgba(155,217,184,.14); border: 1px solid rgba(155,217,184,.25);
    font-size: 13.5px; line-height: 1.6; color: rgba(251,246,240,.82);
  }
  .streaks__insight strong { color: var(--lg-mood-happy); }
  @media (max-width: 980px) { .streaks__inner { grid-template-columns: 1fr; gap: 32px; } .streaks { margin-top: 62px; padding: 52px 0; } }
</style>
